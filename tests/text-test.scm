(require "check.scm")
(require "../core/text.scm")

(check "ascii width" (text-width "abc") 3)
(check "japanese takes two columns" (text-width "日本語") 6)
(check "nerd font glyphs take one column" (text-width "󰉋") 1)
(check "short text stays" (truncate-text "abc" 5) "abc")
(check "long text ends in an ellipsis" (truncate-text "abcdef" 4) "abc…")
(check "wide characters are not split" (truncate-text "日本語" 4) "日…")
(check "zero width gives nothing" (truncate-text "abc" 0) "")
(check "pad-right fills to the width" (pad-right "ab" 4) "ab  ")
(check "relative-path strips the root" (relative-path "/w/src/a.rs" "/w") "src/a.rs")
(check "relative-path keeps outside paths" (relative-path "/x/a.rs" "/w") "/x/a.rs")
(check "relative-path does not strip a sibling prefix" (relative-path "/wx/a" "/w") "/wx/a")
(check-summary!)
