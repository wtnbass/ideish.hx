(require "check.scm")
(require "../agent/protocol.scm")
(require "../agent/session.scm")

(define s (make-session "/w"))
(define (u json) (string->jsexpr json))
(define (kinds) (map entry-kind (reverse (session-entries s))))

(session-push! s 'user (hash 'text "hello"))
(session-apply-update! s (u "{\"sessionUpdate\":\"agent_thought_chunk\",\"content\":{\"type\":\"text\",\"text\":\"think \"}}"))
(session-apply-update! s (u "{\"sessionUpdate\":\"agent_thought_chunk\",\"content\":{\"type\":\"text\",\"text\":\"more\"}}"))
(session-apply-update! s (u "{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Hi \"}}"))
(session-apply-update! s (u "{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"there\"}}"))
(check "chunks of one kind join one entry" (kinds) (list 'user 'thought 'agent))
(check "streamed text is concatenated" (entry-get (car (session-entries s)) 'text) "Hi there")

(define follow
  (session-apply-update! s (u "{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"t1\",\"title\":\"Read README.md\",\"status\":\"pending\",\"locations\":[{\"path\":\"/w/README.md\",\"line\":20},{\"path\":\"/elsewhere/x\"}]}")))
(check "a tool call reports the locations inside the workspace" follow (list (cons "/w/README.md" 20)))
(define tool (car (session-entries s)))
(define rev (entry-rev tool))
(session-apply-update! s (u "{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"t1\",\"status\":\"completed\"}"))
(check "an update changes the same tool entry" (entry-get tool 'status) "completed")
(check "an update keeps fields it does not carry" (entry-get tool 'title) "Read README.md")
(check "an update bumps the entry revision" (> (entry-rev tool) rev) #t)
(session-apply-update! s (u "{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"after\"}}"))
(check "text after a tool call starts a new entry" (kinds) (list 'user 'thought 'agent 'tool 'agent))

(session-apply-update! s (u "{\"sessionUpdate\":\"plan\",\"entries\":[{\"content\":\"a\",\"status\":\"pending\"}]}"))
(session-apply-update! s (u "{\"sessionUpdate\":\"plan\",\"entries\":[{\"content\":\"a\",\"status\":\"completed\"}]}"))
(check "a plan update replaces the plan entry" (length (filter (lambda (k) (equal? k 'plan)) (kinds))) 1)

(set-session-options! s (jget (u "{\"o\":[{\"id\":\"mode\",\"category\":\"mode\",\"currentValue\":\"default\",\"options\":[{\"value\":\"default\",\"name\":\"Manual\"},{\"value\":\"bypass\",\"name\":\"Bypass\",\"_meta\":{\"kind\":\"full_access\"}},{\"value\":\"plan\",\"name\":\"Plan\"}]}]}") 'o))
(define mode (session-option-by-category s "mode"))
(check "the current mode's name" (session-option-value-name mode) "Manual")
(check "the next mode skips full access" (session-next-mode s) "plan")
(session-apply-update! s (u "{\"sessionUpdate\":\"current_mode_update\",\"currentModeId\":\"plan\"}"))
(check "a mode update changes the current value" (session-option-value-name (session-option-by-category s "mode")) "Plan")
(check "the next mode wraps around" (session-next-mode s) "default")
(set-session-options! s (jget (u "{\"o\":[{\"id\":\"mode\",\"category\":\"mode\",\"currentValue\":\"auto\",\"options\":[{\"value\":\"default\",\"name\":\"Manual\"},{\"value\":\"auto\",\"name\":\"Auto\"},{\"value\":\"bypassPermissions\",\"name\":\"Bypass permissions\"}]}]}") 'o))
(check "bypassPermissions is skipped without a _meta kind" (session-next-mode s) "default")
(check "a mode is found by its name" (session-mode-value s "auto") "auto")
(check "a mode is found by its value, ignoring case" (session-mode-value s "MANUAL") "default")
(check "a full-access mode is never chosen" (session-mode-value s "bypassPermissions") #f)

(session-apply-update! s (u "{\"sessionUpdate\":\"session_info_update\",\"title\":\"Fix the bug\"}"))
(check "the session title" (session-title s) "Fix the bug")
(session-reset! s)
(check "reset clears the transcript" (session-entries s) '())
(check-summary!)
